{
  "name": "hangugeo-master-server",
  "version": "0.3.0",
  "description": "한국어 마스터 API server (TypeScript / Express / Postgres)",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "seed:user": "node -r ts-node/register/transpile-only src/scripts/seed-user.ts",
    "mfa:reset": "node -r ts-node/register/transpile-only src/scripts/mfa-reset.ts",
    "ingest:books": "node -r ts-node/register/transpile-only src/scripts/bulk-ingest-books.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "multer": "^2.0.1",
    "nodemailer": "^7.0.9",
    "otplib": "^13.4.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "undici": "^6.20.0",
    "uuid": "^14.0.1",
    "yauzl": "^3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "supertest": "^7.0.0",
    "testcontainers": "^12.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
