# -----------------------------------------------------------------------------
# server/.env.example
# -----------------------------------------------------------------------------
# This file is the source-of-truth example for the env vars the Zod schema in
# `server/src/config/index.ts` requires. Out-of-sync names crash the server at
# startup with "Invalid configuration: bad fields [...]". See REVIEW_B3.md SF3.
#
# Copy to `.env` and fill in real values for local dev:
#   cp .env.example .env
#
# Required-at-startup values have NO default. Optional values are commented out
# and show the default the Zod schema would otherwise use.
# -----------------------------------------------------------------------------

# Core
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# CORS — the single allowed origin for the browser client. REQUIRED.
# In production set to the canonical https URL; in dev the Vite default below.
CLIENT_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Postgres (replaces Supabase per 2026-05-27 decision)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://hangugeo:dev-password@localhost:5432/hangugeo
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# External services
# -----------------------------------------------------------------------------
# Kiwi morphology service (B1). In docker-compose this is the internal DNS
# `http://kiwi:8000`; in bare-metal dev it's wherever you ran the FastAPI app.
KIWI_URL=http://localhost:8000

# Optional: dedicated Claude proxy URL when running the proxy out-of-process.
# Leave unset in single-process dev; the in-process services/claude module is used.
# CLAUDE_PROXY_URL=

# -----------------------------------------------------------------------------
# Image blob store (Pass 8 — Images screen / OCR mining)
# -----------------------------------------------------------------------------
# Filesystem root under which uploaded photos are stored as {userId}/{uuid}.{ext}.
# Relative paths resolve against the process CWD. Durable/offsite (S3) is
# deferred — see SECURITY.md §16. Optional; default below.
# IMAGE_STORAGE_DIR=./var/images
# Per-user DAILY cap on image-OCR uploads (the Vision-cost lever). 429 when hit.
# IMAGE_OCR_DAILY_CAP=20

# -----------------------------------------------------------------------------
# Corpus roots (read-only official-corpus mounts)
# -----------------------------------------------------------------------------
# Where the server streams corpus mp3s from (F-012 — TTMIK/Iyagi/TOPIK audio).
# DB rows store paths RELATIVE to this root. Default /corpus (the deploy
# compose's :ro bind mount); missing dir just 404s, never blocks startup.
# CORPUS_AUDIO_DIR=/corpus
# Where the server serves TOPIK question-figure crops from (F-120 —
# GET /topik/image). Same contract as CORPUS_AUDIO_DIR; defaults to the same
# /corpus mount — a distinct variable so the roots can split later.
# CORPUS_IMAGE_DIR=/corpus

# -----------------------------------------------------------------------------
# Session / cookie
# -----------------------------------------------------------------------------
# SESSION_COOKIE_NAME=km_sid
# SESSION_LIFETIME_DAYS=30
# SESSION_IDLE_TIMEOUT_DAYS=7

# -----------------------------------------------------------------------------
# Auth — login + TOTP 2FA (Pass Login)
# -----------------------------------------------------------------------------
# AES-256-GCM key that encrypts the TOTP factor secret at rest. REQUIRED.
# Must base64-decode to EXACTLY 32 bytes. Generate a fresh one with:
#   openssl rand -base64 32
# SECURITY: this is a PLACEHOLDER ONLY — NEVER commit a real key. The real key
# lives in the deployment env / secret manager, never in a tracked file.
# NOTE: this placeholder does NOT base64-decode to 32 bytes, so copying it
# verbatim will (correctly) FAIL config validation at startup — replace it with a
# real `openssl rand -base64 32` value before the server will boot.
TOTP_SECRET_ENC_KEY=base64-of-32-random-bytes-replace-me

# Registration gate. MUST be false in production (single-user app; seed via the
# `seed:user` CLI). Default true keeps self-service registration in dev/test.
# REGISTRATION_ENABLED=true

# Mandatory-MFA enforcement. Default true: every login requires a confirmed TOTP
# (no confirmed factor → forced enrollment before a session is issued).
# MFA_REQUIRED=true

# Per-account TOTP lockout: N consecutive bad codes lock the account for
# TOTP_LOCKOUT_MINUTES (the IP rate-limit is the other half of the defense).
# TOTP_MAX_FAILED_ATTEMPTS=5
# TOTP_LOCKOUT_MINUTES=15

# Pending login-challenge TTL (seconds). Short by design.
# MFA_CHALLENGE_TTL_SEC=300

# Number of single-use recovery codes minted at enrollment / regenerate.
# RECOVERY_CODE_COUNT=10

# -----------------------------------------------------------------------------
# Rate limits (per window per IP)
# -----------------------------------------------------------------------------
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_CHEAP_MAX=120
# RATE_LIMIT_EXPENSIVE_MAX=20
# RATE_LIMIT_DIAGNOSTIC_MAX=30
# RATE_LIMIT_AUTH_MAX=10

# -----------------------------------------------------------------------------
# Anthropic API (consumed by the in-process B4 Claude proxy module)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key

# Claude proxy — all optional with sane defaults. See services/claude/README.md
# and services/claude/config.ts for the full list.
# CLAUDE_BASE_URL=
# CLAUDE_TIMEOUT_MS=60000
# CLAUDE_RETRY_MAX_ATTEMPTS=3
# CLAUDE_RETRY_BASE_MS=250
# CLAUDE_RETRY_MAX_DELAY_MS=8000
# CLAUDE_DEFAULT_MODEL_ENRICH=claude-haiku-4-5
# CLAUDE_DEFAULT_MODEL_RECOGNIZE_GRAMMAR=claude-sonnet-4-6
# CLAUDE_DEFAULT_MODEL_GRADE_WRITING=claude-sonnet-4-6
# CLAUDE_DEFAULT_MODEL_CONVERSATION=claude-sonnet-4-6
# CLAUDE_MAX_INPUT_ENRICH=2000
# CLAUDE_MAX_INPUT_RECOGNIZE_GRAMMAR=4000
# CLAUDE_MAX_INPUT_GRADE_WRITING=16000
# CLAUDE_MAX_INPUT_CONVERSATION=8000
# CLAUDE_CACHE_TTL_ENRICH_S=2592000         # 30 days
# CLAUDE_CACHE_TTL_RECOGNIZE_GRAMMAR_S=2592000
# CLAUDE_CACHE_TTL_GRADE_WRITING_S=604800   # 7 days
# CLAUDE_CACHE_TTL_CONVERSATION_S=86400     # 1 day
# CLAUDE_RATE_LIMIT_ENRICH=60
# CLAUDE_RATE_LIMIT_RECOGNIZE_GRAMMAR=30
# CLAUDE_RATE_LIMIT_GRADE_WRITING=5
# CLAUDE_RATE_LIMIT_CONVERSATION=10
# Image OCR (Pass 8) — vision-capable tier; not cached (cacheTtl 0).
# CLAUDE_DEFAULT_MODEL_IMAGE_OCR=claude-sonnet-4-6
# CLAUDE_MAX_INPUT_IMAGE_OCR=16000000        # base64 char cap (~8 MiB blob)
# CLAUDE_CACHE_TTL_IMAGE_OCR_S=0             # image bytes make a useless cache key
# CLAUDE_RATE_LIMIT_IMAGE_OCR=10            # per-minute burst ceiling (daily cap is the real lever)
# Grammar production drills (Pass 9) — gen + score, both tool-use, not cached
# (cacheTtl 0: gen wants variety, score depends on the learner's answer).
# CLAUDE_DEFAULT_MODEL_GENERATE_GRAMMAR_DRILL=claude-sonnet-4-6
# CLAUDE_DEFAULT_MODEL_SCORE_GRAMMAR_DRILL=claude-sonnet-4-6
# CLAUDE_MAX_INPUT_GENERATE_GRAMMAR_DRILL=2000   # short pattern + meaning + example
# CLAUDE_MAX_INPUT_SCORE_GRAMMAR_DRILL=4000      # task text + reference + learner answer
# CLAUDE_CACHE_TTL_GENERATE_GRAMMAR_DRILL_S=0    # variety wanted on re-drill
# CLAUDE_CACHE_TTL_SCORE_GRAMMAR_DRILL_S=0       # depends on the learner's answer
# CLAUDE_RATE_LIMIT_GENERATE_GRAMMAR_DRILL=20    # per-minute per-user ceiling
# CLAUDE_RATE_LIMIT_SCORE_GRAMMAR_DRILL=20
