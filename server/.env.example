# -----------------------------------------------------------------------------
# server/.env.example
# -----------------------------------------------------------------------------
# This file is the source-of-truth example for the env vars the Zod schema in
# `server/src/config/index.ts` requires. Out-of-sync names crash the server at
# startup with "Invalid configuration: bad fields [...]". See REVIEW_B3.md SF3.
#
# Copy to `.env` and fill in real values for local dev:
#   cp .env.example .env
#
# Required-at-startup values have NO default. Optional values are commented out
# and show the default the Zod schema would otherwise use.
# -----------------------------------------------------------------------------

# Core
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# CORS — the single allowed origin for the browser client. REQUIRED.
# In production set to the canonical https URL; in dev the Vite default below.
CLIENT_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Postgres (replaces Supabase per 2026-05-27 decision)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://hangugeo:dev-password@localhost:5432/hangugeo
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# External services
# -----------------------------------------------------------------------------
# Kiwi morphology service (B1). In docker-compose this is the internal DNS
# `http://kiwi:8000`; in bare-metal dev it's wherever you ran the FastAPI app.
KIWI_URL=http://localhost:8000

# Optional: dedicated Claude proxy URL when running the proxy out-of-process.
# Leave unset in single-process dev; the in-process services/claude module is used.
# CLAUDE_PROXY_URL=

# -----------------------------------------------------------------------------
# Session / cookie
# -----------------------------------------------------------------------------
# SESSION_COOKIE_NAME=km_sid
# SESSION_LIFETIME_DAYS=30
# SESSION_IDLE_TIMEOUT_DAYS=7

# -----------------------------------------------------------------------------
# Rate limits (per window per IP)
# -----------------------------------------------------------------------------
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_CHEAP_MAX=120
# RATE_LIMIT_EXPENSIVE_MAX=20
# RATE_LIMIT_AUTH_MAX=10

# -----------------------------------------------------------------------------
# Anthropic API (consumed by the in-process B4 Claude proxy module)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key

# Claude proxy — all optional with sane defaults. See services/claude/README.md
# and services/claude/config.ts for the full list.
# CLAUDE_BASE_URL=
# CLAUDE_TIMEOUT_MS=60000
# CLAUDE_RETRY_MAX_ATTEMPTS=3
# CLAUDE_RETRY_BASE_MS=250
# CLAUDE_RETRY_MAX_DELAY_MS=8000
# CLAUDE_DEFAULT_MODEL_ENRICH=claude-haiku-4-5
# CLAUDE_DEFAULT_MODEL_RECOGNIZE_GRAMMAR=claude-sonnet-4-6
# CLAUDE_DEFAULT_MODEL_GRADE_WRITING=claude-sonnet-4-6
# CLAUDE_DEFAULT_MODEL_CONVERSATION=claude-sonnet-4-6
# CLAUDE_MAX_INPUT_ENRICH=2000
# CLAUDE_MAX_INPUT_RECOGNIZE_GRAMMAR=4000
# CLAUDE_MAX_INPUT_GRADE_WRITING=16000
# CLAUDE_MAX_INPUT_CONVERSATION=8000
# CLAUDE_CACHE_TTL_ENRICH_S=2592000         # 30 days
# CLAUDE_CACHE_TTL_RECOGNIZE_GRAMMAR_S=2592000
# CLAUDE_CACHE_TTL_GRADE_WRITING_S=604800   # 7 days
# CLAUDE_CACHE_TTL_CONVERSATION_S=86400     # 1 day
# CLAUDE_RATE_LIMIT_ENRICH=60
# CLAUDE_RATE_LIMIT_RECOGNIZE_GRAMMAR=30
# CLAUDE_RATE_LIMIT_GRADE_WRITING=5
# CLAUDE_RATE_LIMIT_CONVERSATION=10
