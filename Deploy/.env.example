# =============================================================================
# Korean Master — production .env TEMPLATE (blue/green deploy)
# -----------------------------------------------------------------------------
# This is the TEMPLATE only. On the server:
#   1. copy it to a gitignored `.env` in this Deploy/ directory:
#         cp .env.example .env
#   2. fill in REAL values (see each REPLACE-ME below).
#   3. lock it down:  chmod 600 .env   (creds live here at rest).
#
# NEVER commit a real .env. NEVER paste real secrets into THIS file — the CI
# secret-scan must stay green, so every secret below is an obviously-fake
# placeholder. The Azure pipeline holds secrets as secret variables and refreshes
# them into the server .env via save_env_var (deploy decision D2); they are never
# echoed or logged.
#
# All compose files read this via --env-file. Variable NAMES are normative (the
# compose files and scripts reference them exactly) — do not rename, only fill in.
# =============================================================================

# --- Blue/green state (managed by the deploy scripts — do NOT hand-edit) ------
# Which color is currently live on prod (1840). save_env_var flips this on switch.
ACTIVE_ENVIRONMENT=blue
# Image tag per color (set by save_env_var on each deploy; one version per color).
BLUE_IMAGE_TAG=latest
GREEN_IMAGE_TAG=latest

# --- Ports (host bindings) ---------------------------------------------------
# Prod → active color, test → inactive color. Cloudflare Tunnel sits in front of
# the LB and forwards to PRODUCTION_PORT. Direct color ports are loopback-only.
PRODUCTION_PORT=1840
TESTING_PORT=1841
BLUE_PORT=1842
GREEN_PORT=1843

# --- Database (the ONE shared Postgres both colors point at) ------------------
POSTGRES_USER=korean_master
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=korean_master
# Loopback host binding for migrate.py / psql / pg_dump from the host.
POSTGRES_HOST_PORT=5432
# DATABASE_URL is DERIVED, not stored — the three POSTGRES_* values above are the
# single source of truth for the credentials. The containers compose it as
# postgres://USER:PASS@km-db:5432/DB; host-run tooling (db/migrate.py) gets it from
# load_environment as postgres://USER:PASS@127.0.0.1:${POSTGRES_HOST_PORT}/DB. Do
# NOT set it here unless you must pin a non-default host/URL (then it wins).

# --- App DB role (least privilege — B-030, migration 047) ---------------------
# The Express app authenticates as km_app (DML only: SELECT/INSERT/UPDATE/DELETE
# + sequence USAGE — no DDL, no TRUNCATE, no superuser). POSTGRES_USER above is
# the SUPERUSER and is used ONLY by the migration runner, backups, and psql
# tooling. Both compose color files build the app DATABASE_URL from these two
# vars and refuse to start (`${KM_APP_PASSWORD:?…}`) while the password is
# missing.
#
# The password must be URL-SAFE (it is embedded in the container DATABASE_URL).
# Generate one with:
#     openssl rand -hex 32
# Migration 047 creates the role WITHOUT a password (a committed migration must
# never carry a secret, and migrate.py has no variable interpolation — see the
# 047 header). So after the FIRST deploy that applies 047, set it ONCE:
#     bash Deploy/set-km-app-password.sh
# The script reads KM_APP_PASSWORD from this file's real .env, pipes it to psql
# over stdin (never argv, never logged), and verifies km_app can log in. It is
# also the rotation path: change the value here, re-run the script, restart the
# app containers.
KM_APP_USER=km_app
KM_APP_PASSWORD=CHANGE-ME

# --- Application -------------------------------------------------------------
# The public production URL the SPA is served from (Secure/SameSite=Strict cookies
# require the real origin). e.g. https://korean.example.com
CLIENT_ORIGIN=https://REPLACE-ME.example.com
# Anthropic API key. Real keys start with the vendor prefix; this placeholder is
# deliberately NOT a real key so secret-scanners stay green. Replace on the server.
ANTHROPIC_API_KEY=REPLACE-ME-anthropic-api-key
# ElevenLabs API key (F-210 story TTS). OPTIONAL — story TTS stays DORMANT
# until this is set: the server boots and deploys normally with it blank, the
# app hides the "Generate audio" feature (ttsConfigured=false), and any enqueue
# attempt gets a clean 503. To go live: paste the real key here (and optionally
# a Korean narrator voice id below), then redeploy — no code change.
ELEVENLABS_API_KEY=
# ElevenLabs voice id for the single-narrator read. Blank = the server default
# (the ElevenLabs premade "Rachel" voice, multilingual-capable).
ELEVENLABS_VOICE_ID=
# OpenAI API key (F-211 story illustrations, gpt-image-1). OPTIONAL — story
# illustrations stay DORMANT until this is set: the server boots and deploys
# normally with it blank, the app hides the illustration feature
# (imageGenConfigured=false), new stories skip the auto-illustration enqueue,
# and any enqueue attempt gets a clean 503. To go live: paste the real key
# here, then redeploy — no code change.
OPENAI_API_KEY=
# 32 random bytes, base64-encoded, used to encrypt stored TOTP secrets at rest.
# Generate with:  openssl rand -base64 32
TOTP_SECRET_ENC_KEY=base64-of-32-random-bytes-REPLACE-ME
# Registration is OFF in prod (invite/admin-provision only); MFA is required.
REGISTRATION_ENABLED=false
MFA_REQUIRED=true
LOG_LEVEL=info
# Where the server writes user-uploaded OCR images (mounted as the shared
# km_images volume on BOTH colors so uploads survive a switch).
IMAGE_STORAGE_DIR=/app/var/images
# Where the server writes user-uploaded book PDFs (U1a) (mounted as the shared
# km_book_uploads volume on BOTH colors so uploads survive a switch).
BOOK_UPLOAD_STORAGE_DIR=/app/var/book-uploads
# KIWI_URL is set PER-COLOR by the compose files (http://km-kiwi-<color>:8000) —
# do NOT set it here; the .env is color-agnostic.

# --- Kiwi (morphological analyzer) — optional tuning -------------------------
KIWI_MODEL_SIZE=base
KIWI_LOG_LEVEL=INFO
KIWI_MAX_INPUT_CHARS=4096

# --- Audio transcription worker (km-worker — Track A GPU Whisper) -------------
# Image tag for the km-worker service (docker-compose.shared.yml). UNLIKE the
# per-color tags above, this image is built ON the host (`build_worker` in
# deployment-utils.sh — the CUDA + baked-large-v3 image is multi-GB and never
# ships via CI), so `latest` is the normal steady-state value here.
WORKER_IMAGE_TAG=latest
# Worker knobs (compose bakes these defaults; uncomment to override).
# WHISPER_MODEL=large-v3        # must be baked into the image (no runtime egress)
# WHISPER_DEVICE=auto           # auto → cuda when the GPU is reserved, else cpu
# WHISPER_COMPUTE_TYPE=auto     # auto → float16 on cuda, int8 on cpu
# AUDIO_STALE_RUN_MINUTES=60    # stale-'running' reap threshold (076)
# POLL_INTERVAL_SEC=5           # idle sleep between empty queue polls

# --- Backups -----------------------------------------------------------------
# pg_dump target — a HOST directory (the containers bind-mount it at /backups).
# In PRODUCTION this is the host's NFS mount point for the NAS share, so nightly
# dumps are stored on the NAS (live DB data stays on local disk — never put the
# Postgres data dir on a network share). Mount the NFS export here via fstab
# BEFORE deploying. Leave blank to default to <dir of this .env>/backups (local).
BACKUP_DIR=/home/patrick/Services/KoreanMaster/Backup
# Refuse to back up when BACKUP_DIR is NOT a real mountpoint (i.e. the NAS/NFS
# share is unmounted) — prevents silently writing backups to local disk. Set true
# in production once the NFS mount is in place. Enforced by the HOST pre-deploy
# backup; the in-container nightly sidecar can't see the host mount state.
BACKUP_REQUIRE_MOUNT=false
BACKUP_RETENTION_DAYS=90
# Nightly run time in BACKUP_TZ (24h HH:MM).
BACKUP_TIME=03:00
BACKUP_TZ=America/Chicago
# OPTIONAL second offsite copy target (pending dad's Q-BACKUP decision). Empty =
# skip offsite, log "offsite skipped". Set to an absolute path / mount to enable.
BACKUP_OFFSITE_DIR=
# How db-backup.sh reaches Postgres: `exec` (host: docker exec km-db pg_dump —
# the default) or `direct` (in-container: pg_dump -h km-db). The km-backup sidecar
# sets `direct` itself in docker-compose.shared.yml; you normally leave this unset.
# BACKUP_DB_ACCESS=exec

# --- Resource limits (optional overrides; sane defaults baked into compose) ---
# Uncomment to override the per-service caps.
# LB_MEM_LIMIT=256m
# DB_MEM_LIMIT=2g
# SERVER_MEM_LIMIT=1g
# CLIENT_MEM_LIMIT=128m
# KIWI_MEM_LIMIT=512m
# BACKUP_MEM_LIMIT=256m
# WORKER_MEM_LIMIT=12g
# WORKER_CPU_LIMIT=4.0
