# =============================================================================
# Korean Master — Client production image (multi-stage)
# -----------------------------------------------------------------------------
# Stage 1 builds the Vite SPA; stage 2 serves the static output with nginx.
#
# BUILD CONTEXT = REPOSITORY ROOT (not client/). This Dockerfile copies BOTH
# the client source (client/) AND the load-balancer-adjacent nginx config
# (Deploy/client-nginx.conf), so the build context must contain both trees.
# The Azure pipeline builds it as:
#     docker build -f client/Dockerfile.prod -t km-client:<tag> .
# (run from the repo root). All COPY paths below are therefore repo-root-relative.
#
# SAME-ORIGIN POSTURE (LOCKED — client/SECURITY.md §1/§2, ADR-002):
# VITE_API_URL is intentionally left UNSET at build time. With it unset, api.ts
# resolves its base URL to the empty string (`import.meta.env.VITE_API_URL ?? ''`)
# and the SPA issues relative, same-origin requests (/auth, /vocab, /health, ...).
# The load balancer then splits a single origin by path between this client and
# the API. Do NOT set VITE_API_URL=/api here — that would reintroduce a prefix
# that contradicts the locked same-origin design.
# =============================================================================

# --- Stage 1: build ----------------------------------------------------------
# node:22-alpine (current LTS): Node 20 reached EOL 2026-04-30. F-085 aligns
# the client build image with the server (server/Dockerfile), CI
# (.github/workflows/ci.yml), and the compose healthcheck comments so the
# whole repo runs one Node major.
FROM node:22-alpine AS build

WORKDIR /app

# Install dependencies against the lockfile for reproducible builds.
# Repo-root-relative paths (build context is the repository root).
COPY client/package.json client/package-lock.json ./
RUN npm ci

# Build the SPA. VITE_API_URL is deliberately NOT passed -> empty base ->
# same-origin requests at runtime.
COPY client/ .
RUN npm run build

# --- Stage 2: serve ----------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

# Static-only nginx: serves the SPA + /healthz; the API split is done by the LB.
COPY Deploy/client-nginx.conf /etc/nginx/conf.d/default.conf

# Vite's default output directory is dist/.
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

# Container-level liveness check against the local /healthz.
# 127.0.0.1, NOT localhost: nginx `listen 80` is IPv4-only, but `localhost`
# resolves to ::1 (IPv6) first inside the container, so busybox wget would get
# connection-refused. -q/--spider are the only BusyBox-supported wget forms.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:80/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
