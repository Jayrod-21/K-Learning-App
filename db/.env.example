# =============================================================================
# Korean Master — database environment template
# =============================================================================
# Copy to .env in this directory (db/.env) AND/OR to the Repository root .env
# (the Makefile loads db/.env when present; docker-compose loads root .env).
#
# NEVER commit .env files. The compose stack reads these via env_file directive.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres credentials — used by the `db` service AND by migrate.py
# -----------------------------------------------------------------------------
# POSTGRES_USER / POSTGRES_PASSWORD are consumed by the official postgres
# image on first boot to create the superuser. They are also used by
# DATABASE_URL below for connections from the host (migrate.py, tests).
POSTGRES_USER=korean_master
POSTGRES_PASSWORD=change_me_minimum_32_chars_of_entropy_please
POSTGRES_DB=korean_master

# Bind port on the host. Default 5432 — change if you already run Postgres
# locally. The compose file binds to 127.0.0.1 only (never 0.0.0.0); the
# Cloudflare Tunnel reaches the app, not the DB.
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# Connection URL used by migrate.py, tests, and the app server
# -----------------------------------------------------------------------------
# Host-side connection (migrate.py from your workstation, pytest):
DATABASE_URL=postgres://korean_master:change_me_minimum_32_chars_of_entropy_please@127.0.0.1:5432/korean_master

# In-network connection from sibling compose services (server container):
# DATABASE_URL_INTERNAL=postgres://korean_master:...@db:5432/korean_master

# -----------------------------------------------------------------------------
# Backup location on the host
# -----------------------------------------------------------------------------
# Backups are written here by db/scripts/backup.sh. Directory is created with
# mode 0700 (owner-only) — pg_dump files contain everything an attacker needs.
BACKUP_DIR=./db/backups

# Retention in days for daily backups. Older files are pruned by backup.sh.
BACKUP_RETENTION_DAYS=14

# -----------------------------------------------------------------------------
# Resource hints (consumed by docker-compose deploy.resources)
# -----------------------------------------------------------------------------
# Dad's Ubuntu box has ~16 GB RAM — give Postgres a safe slice, leave the rest
# for Kiwi, the Express server, and the OS.
DB_MEM_LIMIT=2g
DB_CPU_LIMIT=2.0
