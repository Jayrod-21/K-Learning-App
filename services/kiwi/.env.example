# =============================================================================
# Kiwi service — example env. Copy to .env for local dev. Production values
# live in the host's secret store, not in this file.
# =============================================================================

# --- HTTP --------------------------------------------------------------------
# Inside docker-compose this is fine as 0.0.0.0 because the `internal` network
# is not routed to the public internet. The Express gateway reaches us at
# http://kiwi:8000 on that network.
KIWI_HOST=0.0.0.0
KIWI_PORT=8000

# --- Model -------------------------------------------------------------------
# small | base | large. See ADR-014 for the choice rationale.
KIWI_MODEL_SIZE=base

# --- Limits ------------------------------------------------------------------
# Hard cap on input length per request (chars). See SECURITY.md §T1.
# 4 KB is enough for any single sentence the tap-a-word flow sends.
KIWI_MAX_INPUT_CHARS=4096

# Per-request wall-clock budget (seconds). Backstop; B3 will time out faster.
KIWI_REQUEST_TIMEOUT_SECONDS=5.0

# --- Observability -----------------------------------------------------------
KIWI_LOG_LEVEL=INFO
KIWI_SERVICE_NAME=kiwi-service
